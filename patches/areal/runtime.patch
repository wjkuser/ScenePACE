diff --git a/tests/test_fsdp_runtime_checkpoint.py b/tests/test_fsdp_runtime_checkpoint.py
new file mode 100644
index 0000000..c62b21c
--- /dev/null
+++ b/tests/test_fsdp_runtime_checkpoint.py
@@ -0,0 +1,180 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CPU checks of real DCP optimizer/runtime recovery (no FSDP mocking)."""
+
+import copy
+import json
+import random
+from datetime import timedelta
+from pathlib import Path
+from unittest.mock import Mock
+
+import numpy as np
+import pytest
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+from torch import nn
+
+from areal.engine.fsdp_engine import FSDPEngine
+
+
+def _engine():
+    engine = object.__new__(FSDPEngine)
+    engine.model = nn.Sequential(nn.Linear(4, 4), nn.Dropout(0.3), nn.Linear(4, 1))
+    engine.optimizer = torch.optim.AdamW(engine.model.parameters(), lr=0.01)
+    engine.lr_scheduler = torch.optim.lr_scheduler.StepLR(
+        engine.optimizer, step_size=2, gamma=0.5
+    )
+    engine._version = 0
+    engine._initialized = True
+    engine.logger = Mock()
+    return engine
+
+
+def _step(engine):
+    engine.optimizer.zero_grad()
+    inputs = torch.randn(3, 4) * np.random.uniform() + random.random()
+    loss = engine.model(inputs).square().mean()
+    loss.backward()
+    if dist.is_initialized():
+        for parameter in engine.model.parameters():
+            dist.all_reduce(parameter.grad)
+            parameter.grad.div_(dist.get_world_size())
+    engine.optimizer.step()
+    engine.lr_scheduler.step()
+    engine.set_version(engine.get_version() + 1)
+    return loss.detach()
+
+
+def _assert_nested_equal(actual, expected):
+    if isinstance(expected, torch.Tensor):
+        torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    elif isinstance(expected, dict):
+        assert actual.keys() == expected.keys()
+        for key in expected:
+            _assert_nested_equal(actual[key], expected[key])
+    elif isinstance(expected, (list, tuple)):
+        assert len(actual) == len(expected)
+        for left, right in zip(actual, expected):
+            _assert_nested_equal(left, right)
+    else:
+        assert actual == expected
+
+
+@pytest.fixture(autouse=True)
+def cpu_only(monkeypatch):
+    monkeypatch.setattr(torch.cuda, "is_available", lambda: False)
+
+
+def test_dcp_resume_matches_uninterrupted_optimizer_update(tmp_path):
+    random.seed(101)
+    np.random.seed(102)
+    torch.manual_seed(103)
+    original = _engine()
+    for _ in range(5):
+        _step(original)
+    original._save_to_dcp(str(tmp_path), with_optim=True)
+    expected_losses = [_step(original) for _ in range(3)]
+    expected_model = copy.deepcopy(original.model.state_dict())
+    expected_optim = copy.deepcopy(original.optimizer.state_dict())
+    expected_scheduler = copy.deepcopy(original.lr_scheduler.state_dict())
+
+    # Simulate a new worker with unrelated initialization and random streams.
+    random.seed(901)
+    np.random.seed(902)
+    torch.manual_seed(903)
+    restored = _engine()
+    restored._load_from_dcp(str(tmp_path), with_optim=True)
+    assert restored.get_version() == 5
+    actual_losses = [_step(restored) for _ in range(3)]
+
+    _assert_nested_equal(actual_losses, expected_losses)
+    _assert_nested_equal(restored.model.state_dict(), expected_model)
+    _assert_nested_equal(restored.optimizer.state_dict(), expected_optim)
+    _assert_nested_equal(restored.lr_scheduler.state_dict(), expected_scheduler)
+    assert restored.get_version() == original.get_version() == 8
+
+
+def test_dcp_marked_checkpoint_missing_rank_state_fails(tmp_path):
+    engine = _engine()
+    _step(engine)
+    engine._save_to_dcp(str(tmp_path), with_optim=True)
+    (tmp_path / "engine_state_rank_0.pt").unlink()
+    with pytest.raises(FileNotFoundError):
+        _engine()._load_from_dcp(str(tmp_path), with_optim=True)
+
+
+def test_dcp_changed_world_size_fails(tmp_path):
+    (tmp_path / "engine_state.json").write_text(
+        json.dumps({"format_version": 1, "world_size": 2})
+    )
+    with pytest.raises(RuntimeError, match="world size"):
+        _engine()._load_from_dcp(str(tmp_path), with_optim=True)
+
+
+def test_dcp_legacy_checkpoint_warns_without_claiming_full_resume(tmp_path):
+    original = _engine()
+    _step(original)
+    original._save_to_dcp(str(tmp_path), with_optim=True)
+    (tmp_path / "engine_state.json").unlink()
+    (tmp_path / "engine_state_rank_0.pt").unlink()
+    restored = _engine()
+    restored._load_from_dcp(str(tmp_path), with_optim=True)
+    restored.logger.warning.assert_called_once()
+    _assert_nested_equal(restored.model.state_dict(), original.model.state_dict())
+    _assert_nested_equal(
+        restored.optimizer.state_dict(), original.optimizer.state_dict()
+    )
+
+
+def _distributed_resume_worker(rank, checkpoint_dir, init_file):
+    torch.cuda.is_available = lambda: False
+    dist.init_process_group(
+        "gloo",
+        init_method=f"file://{init_file}",
+        rank=rank,
+        world_size=2,
+        timeout=timedelta(seconds=60),
+    )
+    try:
+        torch.manual_seed(103)
+        original = _engine()
+        original._cpu_group = dist.group.WORLD
+        # Identical parameters, but a separate stochastic stream on each rank.
+        random.seed(101 + rank)
+        np.random.seed(102 + rank)
+        torch.manual_seed(104 + rank)
+        for _ in range(5):
+            _step(original)
+        original._save_to_dcp(checkpoint_dir, with_optim=True)
+        expected_losses = [_step(original) for _ in range(3)]
+        expected_model = copy.deepcopy(original.model.state_dict())
+        expected_optim = copy.deepcopy(original.optimizer.state_dict())
+        restored = _engine()
+        restored._cpu_group = dist.group.WORLD
+        restored._load_from_dcp(checkpoint_dir, with_optim=True)
+        actual_losses = [_step(restored) for _ in range(3)]
+        _assert_nested_equal(actual_losses, expected_losses)
+        _assert_nested_equal(restored.model.state_dict(), expected_model)
+        _assert_nested_equal(restored.optimizer.state_dict(), expected_optim)
+        assert restored.get_version() == 8
+        # Both ranks must fail promptly even if only one runtime shard is lost.
+        if rank == 1:
+            (Path(checkpoint_dir) / "engine_state_rank_1.pt").unlink()
+        dist.barrier()
+        with pytest.raises(RuntimeError, match="DCP runtime validation failed"):
+            restored._load_from_dcp(checkpoint_dir, with_optim=True)
+    finally:
+        dist.destroy_process_group()
+
+
+@pytest.mark.slow
+@pytest.mark.ci
+def test_dcp_two_cpu_ranks_preserve_independent_rng_and_fail_together(tmp_path):
+    mp.start_processes(
+        _distributed_resume_worker,
+        args=(str(tmp_path / "checkpoint"), str(tmp_path / "init")),
+        nprocs=2,
+        join=True,
+        start_method="spawn",
+    )
